# Backend environment — copy to .env and fill in real values
# Never commit .env to git

# API server port
PORT=4000

# PostgreSQL connection (used by Drizzle ORM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=group_app

# Or use a single DATABASE_URL (Docker / cloud providers)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/group_app

# Clerk secret key (backend)
# Get this from https://dashboard.clerk.com → Application → API Keys
# Looks like sk_test_xxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_...
