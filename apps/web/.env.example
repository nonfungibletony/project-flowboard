# Frontend environment — copy to .env and fill in real values
# Never commit .env to git

# API base URL (used by the web app to call the backend)
# In Docker: use http://api:4000
# Localhost: http://localhost:4000
VITE_API_URL=http://localhost:4000

# Clerk publishable key (frontend)
# Get this from https://dashboard.clerk.com → Application → API Keys
# Looks like pk_test_xxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
